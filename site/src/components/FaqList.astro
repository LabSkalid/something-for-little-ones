---
interface Faq {
  question: string;
  answer: string;
}

interface Props {
  items: Faq[];
  heading?: string;
}

const { items, heading = 'Questions parents ask' } = Astro.props;
---

{items.length > 0 && (
  <section class="faq-band" aria-labelledby="faq-heading">
    <div class="wrap">
      <h2 id="faq-heading">{heading}</h2>
      <div class="faq-list">
        {items.map((faq) => (
          <details class="faq-item">
            <summary>
              <span>{faq.question}</span>
              <svg class="chevron" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
                <path d="M5 7.5 10 12.5 15 7.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .faq-band {
    margin-top: 2.75rem;
    background: var(--soft);
    color: var(--ink);
    font-family: var(--sans);
    padding: 2.15rem 0 2.4rem;
  }

  .faq-band h2 {
    margin: 0 0 1.15rem;
    font-family: var(--sans);
    font-size: 1.28rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: none;
  }

  .faq-list {
    border-top: 1px solid var(--line);
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.15rem;
    padding: 0.85rem 0.1rem;
    list-style: none;
    cursor: pointer;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.4;
    text-transform: none;
  }

  .faq-item summary::-webkit-details-marker,
  .faq-item summary::marker {
    content: '';
    display: none;
  }

  .faq-item summary span {
    flex: 1;
    min-width: 0;
  }

  .faq-item summary:hover {
    color: var(--accent-dark);
  }

  .faq-item summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .chevron {
    flex: none;
    color: var(--muted);
    transition: transform 0.18s ease;
  }

  .faq-item[open] .chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 1.75rem 1.15rem 0.1rem;
    max-width: 68ch;
  }

  .faq-answer p {
    margin: 0;
    color: #314047;
    font-family: var(--sans);
    font-size: 1.02rem;
    font-weight: 400;
    line-height: 1.65;
    text-transform: none;
  }
</style>
