---
import { sheetAssets, sheetPath } from '../lib/paths';
import { ageBandLabel } from '../lib/ages';
import type { CollectionEntry } from 'astro:content';

interface Props {
  sheet: CollectionEntry<'sheets'>;
}

const { sheet } = Astro.props;
const assets = sheetAssets(sheet.data.theme, sheet.data.slug);
---

<a class="sheet-card" href={sheetPath(sheet.data.theme, sheet.data.slug)}>
  <img
    src={assets.png}
    alt={sheet.data.alt}
    width="640"
    height="800"
    loading="lazy"
    data-pin-description={`${sheet.data.title}. ${sheet.data.description}`}
  />
  <div>
    <h3>{sheet.data.title}</h3>
    <p class="meta">{ageBandLabel(sheet.data.age)}</p>
    <span class="card-action">Print</span>
  </div>
</a>
