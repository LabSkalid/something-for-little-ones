---
import type { BookOffer as BookOfferData } from '../lib/books';

interface Props {
  book: BookOfferData;
}

const { book } = Astro.props;
const actions: { href: string; label: string }[] = [];
if (book.kofiUrl) actions.push({ href: book.kofiUrl, label: `PDF · ${book.pdfPrice} on Ko-fi` });
if (book.amazonUrl) actions.push({ href: book.amazonUrl, label: `Paperback · ${book.paperbackPrice} on Amazon` });
---

<div class="book-offer">
  <a class="book-offer-cover" href={book.amazonUrl} target="_blank" rel="noopener noreferrer">
    <img
      src={book.cover}
      alt={book.coverAlt}
      width="400"
      height="600"
      loading="lazy"
      decoding="async"
    />
  </a>
  <h2>{book.title}</h2>
  <p>{book.body}</p>
  <div class="book-offer-actions">
    {actions.map((action, index) => (
      <a class:list={['btn', { 'btn-ghost': index > 0 }]} href={action.href} target="_blank" rel="noopener noreferrer">{action.label}</a>
    ))}
  </div>
</div>
