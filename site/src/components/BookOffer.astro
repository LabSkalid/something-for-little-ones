---
import type { BookOffer as BookOfferData } from '../lib/books';

interface Props {
  book: BookOfferData;
}

const { book } = Astro.props;
---

<div class="book-offer">
  <a class="book-offer-cover" href={book.amazonUrl} target="_blank" rel="noopener noreferrer">
    <img
      src={book.cover}
      alt={book.coverAlt}
      width="400"
      height="600"
      loading="lazy"
      decoding="async"
    />
  </a>
  <h2>{book.title}</h2>
  <p>{book.body}</p>
  <div class="book-offer-actions">
    <a class="btn" href={book.amazonUrl} target="_blank" rel="noopener noreferrer">Paperback on Amazon</a>
    <a class="btn btn-ghost" href={book.kofiUrl} target="_blank" rel="noopener noreferrer">PDF on Ko-fi</a>
  </div>
</div>
