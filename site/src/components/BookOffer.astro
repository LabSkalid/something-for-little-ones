---
import type { BookOffer as BookOfferData } from '../lib/books';

interface Props {
  book: BookOfferData;
}

const { book } = Astro.props;
const actions: { href: string; label: string; store: string }[] = [];
if (book.kofiUrl) actions.push({ href: book.kofiUrl, label: `PDF · ${book.pdfPrice} on Ko-fi`, store: 'kofi' });
if (book.amazonUrl) actions.push({ href: book.amazonUrl, label: `Paperback · ${book.paperbackPrice} on Amazon`, store: 'amazon' });
const cover = book.amazonUrl
  ? { href: book.amazonUrl, store: 'amazon' }
  : book.kofiUrl
    ? { href: book.kofiUrl, store: 'kofi' }
    : undefined;
---

<div class="book-offer">
  {cover && (
  <a class="book-offer-cover" href={cover.href} target="_blank" rel="noopener noreferrer" data-book-store={cover.store} data-book-id={book.id} data-book-place="theme">
    <img
      src={book.cover}
      alt={book.coverAlt}
      width="400"
      height="600"
      loading="lazy"
      decoding="async"
    />
  </a>
  )}
  <h2>{book.title}</h2>
  <p>{book.body}</p>
  <div class="book-offer-actions">
    {actions.map((action, index) => (
      <a class:list={['btn', { 'btn-ghost': index > 0 }]} href={action.href} target="_blank" rel="noopener noreferrer" data-book-store={action.store} data-book-id={book.id} data-book-place="theme">{action.label}</a>
    ))}
  </div>
</div>
