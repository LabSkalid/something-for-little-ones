---
interface Props {
  href: string;
  title: string;
  image: string;
  imageAlt: string;
  count: number;
  eyebrow: string;
}

const { href, title, image, imageAlt, count, eyebrow } = Astro.props;
---

<a class="theme-card" href={href}>
  <img src={image} alt={imageAlt} width="640" height="800" loading="lazy" />
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    <p class="meta">{count} pages</p>
    <span class="card-action">See all</span>
  </div>
</a>
