---
import { site } from '../site';

const year = new Date().getFullYear() || 2026;
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-brand">
      <p class="footer-name">{site.name}</p>
      <p class="footer-tagline">Simple things to print, color, and enjoy.</p>
    </div>
    <nav class="footer-links" aria-label="Browse">
      <a href="/">Coloring Pages</a>
      <a href="/#holidays">Seasonal Printables</a>
    </nav>
    <nav class="footer-links footer-links-quiet" aria-label="Information">
      <a href="/about/">About</a>
      <a href="/how-to-print/">How to Print</a>
      <a href="/contact/">Contact</a>
      <a href="/privacy/">Privacy</a>
    </nav>
    <div class="footer-copy">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>Free for personal and classroom use.</p>
    </div>
  </div>
</footer>
