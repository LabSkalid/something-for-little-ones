---
import { getCollection } from 'astro:content';
import Wordmark from './Wordmark.astro';
import { ageBands } from '../lib/ages';
import { themePath } from '../lib/paths';

const themes = (await getCollection('themes')).sort((a, b) => a.data.order - b.data.order);
const holidays = themes.filter((theme) => theme.data.kind === 'seasonal');
const bands = ageBands.map((band) => ({
  ...band,
  themes: themes.filter((theme) => theme.data.kind !== 'seasonal' && theme.data.ageBand === band.id),
}));
const columns = [
  bands.filter((band) => band.id === '2-3' || band.id === '3-4'),
  bands.filter((band) => band.id === '4-5' || band.id === '5-6' || band.id === '6-8'),
];
---

<footer class="site-footer">
  <div class="crayon-rule" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </div>
  <div class="wrap">
    <div class="footer-layout">
      <div class="footer-brand">
        <Wordmark />
        <p>Coloring pages to print at home. Pick an age, then download the PDF.</p>
      </div>
      {columns.map((column) => (
        <div class="footer-col">
          {column.map((band) => (
            <div>
              <h2>{band.label}</h2>
              {band.themes.map((theme) => (
                <a href={themePath(theme.id)}>{theme.data.title}</a>
              ))}
            </div>
          ))}
        </div>
      ))}
      <nav class="footer-col" aria-label="Holidays">
        <h2>Holidays</h2>
        {holidays.map((theme) => (
          <a href={themePath(theme.id)}>{theme.data.title}</a>
        ))}
      </nav>
      <nav class="footer-col" aria-label="Site">
        <h2>On this site</h2>
        <a href="/how-to-print/">How to print</a>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
        <a href="/privacy/">Privacy</a>
      </nav>
    </div>
    <div class="footer-bottom">
      <p>Personal and classroom printing is free. Please don't resell the files.</p>
    </div>
  </div>
</footer>
