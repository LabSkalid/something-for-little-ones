---
import { getCollection } from 'astro:content';
import { site } from '../site';
import { ageBands } from '../lib/ages';
import { themePath } from '../lib/paths';

const year = new Date().getFullYear() || 2026;
const themes = await getCollection('themes');
const bandOrder = ageBands.map((band) => band.id);

const byAgeThenOrder = (a: (typeof themes)[number], b: (typeof themes)[number]) => {
  const age = bandOrder.indexOf(a.data.ageBand) - bandOrder.indexOf(b.data.ageBand);
  if (age !== 0) return age;
  return a.data.order - b.data.order;
};

/** Drop the repeated suffix so the column stays a short vertical list. */
function themeLabel(title: string) {
  return title.replace(/ Coloring Pages$/, '');
}

const everyday = themes.filter((theme) => theme.data.kind !== 'seasonal').sort(byAgeThenOrder);
const holidays = themes
  .filter((theme) => theme.data.kind === 'seasonal')
  .sort((a, b) => a.data.order - b.data.order);
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="footer-name">{site.name}</p>
        <p class="footer-tagline">Simple things to print, color, and enjoy.</p>
        <a class="footer-email" href={`mailto:${site.email}`}>{site.email}</a>
      </div>

      <nav class="footer-col" aria-label="Explore">
        <p class="footer-heading">Explore</p>
        <ul>
          <li><a href="/">Coloring Pages</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/how-to-print/">How to Print</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy/">Privacy</a></li>
        </ul>
      </nav>

      <nav class="footer-col" aria-label="Themes">
        <p class="footer-heading">Themes</p>
        <ul>
          {
            everyday.map((theme) => (
              <li>
                <a href={themePath(theme.id)}>{themeLabel(theme.data.title)}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="footer-col" aria-label="Holidays">
        <p class="footer-heading">Holidays</p>
        <ul>
          {
            holidays.map((theme) => (
              <li>
                <a href={themePath(theme.id)}>{themeLabel(theme.data.title)}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <nav class="footer-elsewhere" aria-label="Shop and social">
      <a
        class="footer-elsewhere-link"
        href="https://www.amazon.com/stores/author/B0HMP3YMB5/allbooks"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="footer-elsewhere-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            fill="currentColor"
            d="M9 7V6a3 3 0 0 1 6 0v1h2.5A1.5 1.5 0 0 1 19 8.5v11A1.5 1.5 0 0 1 17.5 21h-11A1.5 1.5 0 0 1 5 19.5v-11A1.5 1.5 0 0 1 6.5 7H9zm2 0h2V6a1 1 0 1 0-2 0v1z"
          />
        </svg>
        <span>Amazon</span>
      </a>
      <a
        class="footer-elsewhere-link"
        href="https://ko-fi.com/smthflo/shop"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="footer-elsewhere-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            fill="currentColor"
            d="M18.5 7H17V6.2c0-1.2-1-2.2-2.2-2.2H5.2C4 4 3 5 3 6.2v7.6C3 16.4 5.6 18 8.5 18s5.5-1.6 5.5-4.2V9h1.5c1.9 0 3.5 1.3 3.5 3s-1.6 3-3.5 3H16v1.5h1c2.8 0 5-2 5-4.5S21.3 7 18.5 7zM12 13.8c0 1.5-1.5 2.7-3.5 2.7S5 15.3 5 13.8V6.2c0-.1.1-.2.2-.2h9.6c.1 0 .2.1.2.2v7.6z"
          />
        </svg>
        <span>Ko-fi</span>
      </a>
      <a
        class="footer-elsewhere-link"
        href="https://www.pinterest.com/somethingforlittleones/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="footer-elsewhere-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 2C6.5 2 2 6.5 2 12c0 4.2 2.6 7.8 6.3 9.3-.1-.8-.2-2 0-2.9.2-.8 1.2-5 1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.8 0 1.3.6 1.3 1.4 0 .9-.5 2.1-.8 3.3-.2 1 .5 1.8 1.5 1.8 1.8 0 3.1-1.9 3.1-4.6 0-2.4-1.7-4.1-4.2-4.1-2.8 0-4.5 2.1-4.5 4.3 0 .9.3 1.8.8 2.3.1.1.1.2.1.3l-.3 1.1c0 .2-.1.2-.3.1-1.3-.6-2-2.4-2-3.9 0-3.2 2.3-6.1 6.6-6.1 3.5 0 6.1 2.5 6.1 5.8 0 3.4-2.2 6.2-5.2 6.2-1 0-2-.5-2.3-1.2l-.6 2.4c-.2.9-.8 2-1.2 2.6.9.3 1.9.4 2.9.4 5.5 0 10-4.5 10-10S17.5 2 12 2z"
          />
        </svg>
        <span>Pinterest</span>
      </a>
    </nav>

    <div class="footer-copy">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>Free for personal and classroom use.</p>
    </div>
  </div>
</footer>
