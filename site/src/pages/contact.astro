---
import Base from '../layouts/Base.astro';
import { site } from '../site';
---

<Base title="Get in Touch" description="Email Julia with a question about a printable, something that isn't working, or an idea you'd like to see on Something for Little Ones." path="/contact/">
  <div class="wrap prose">
    <p class="eyebrow">Contact</p>
    <h1>Get in Touch</h1>
    <p>Have a question about a printable, found something that isn't working, or have an idea for something you'd like to see here?</p>
    <p>I'd love to hear from you.</p>
    <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
    <p>If you're writing about a particular coloring page or printable, feel free to include the page name or link so I can find it quickly.</p>
    <p>Thanks for stopping by!</p>
    <p>Julia</p>
  </div>
</Base>
