---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SheetCard from '../../components/SheetCard.astro';
import AgeSeoLinks from '../../components/AgeSeoLinks.astro';
import ThemeCard from '../../components/ThemeCard.astro';
import { ageBandLabel, ageBands } from '../../lib/ages';
import { sheetAssets, themePath } from '../../lib/paths';
import { absoluteUrl, site } from '../../site';

export async function getStaticPaths() {
  const themes = await getCollection('themes');
  return themes.map((theme) => ({ params: { theme: theme.id }, props: { theme } }));
}

const { theme } = Astro.props;
const { Content } = await render(theme);
const allSheets = await getCollection('sheets');
const sheets = allSheets.filter((sheet) => sheet.data.theme === theme.id).sort((a, b) => a.data.order - b.data.order);
const themes = await getCollection('themes');
const related = theme.data.related.flatMap((id) => {
  const item = themes.find((entry) => entry.id === id);
  if (!item) return [];
  const pool = allSheets.filter((sheet) => sheet.data.theme === item.id).sort((a, b) => a.data.order - b.data.order);
  const first = pool[0];
  return first ? [{ item, image: sheetAssets(item.id, first.data.slug).png, alt: first.data.alt, count: pool.length }] : [];
});
const pagePath = themePath(theme.id);
const ages = new Set(sheets.map((sheet) => sheet.data.age));
const groupedByAge = ages.size > 1;
const crumbs = [{ name: 'Home', path: '/' }, { name: theme.data.title, path: pagePath }];
---

<Base title={theme.data.title} description={theme.data.description} path={pagePath}>
  <div class="wrap">
    <Breadcrumbs items={crumbs} />
    <header class="collection-header">
      <h1>{theme.data.title}</h1>
      {theme.data.tagline && <p class="lede">{theme.data.tagline}</p>}
    </header>

    <section class="collection-description prose" aria-label={`${theme.data.title} description`}>
      <Content />
    </section>

    <section class="section" aria-label={theme.data.title}>
      <div class="sheet-grid">
        {sheets.map((sheet) => <SheetCard sheet={sheet} />)}
      </div>
    </section>

    <AgeSeoLinks sheets={sheets} themeId={theme.id} groupedByAge={groupedByAge} />

    {related.length > 0 && (
      <section class="section related-themes">
        <div class="section-head"><h2>Related coloring pages</h2></div>
        <div class="theme-grid">
          {related.map(({ item, image, alt, count }) => (
            <ThemeCard href={themePath(item.id)} title={item.data.title} image={image} imageAlt={alt} count={count} eyebrow={ageBandLabel(item.data.ageBand)} />
          ))}
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  .collection-header { margin: 1.5rem 0 1rem; }
  .collection-header h1 { margin-bottom: .5rem; }
  .collection-description { margin: 1rem 0 1.75rem; }
  .collection-description :global(p) { margin: 0; }
  .sheet-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .related-themes { margin-top: 2.5rem; }
  .theme-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  @media (min-width: 700px) { .sheet-grid, .theme-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
