---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqList from '../../components/FaqList.astro';
import SheetCard from '../../components/SheetCard.astro';
import { pinPath, sheetPath, themePath } from '../../lib/paths';
import { breadcrumbLd, founderId, publisherRef } from '../../lib/schema';
import { absoluteUrl, site } from '../../site';
import { ageBandLabel, ageBands, ageSpanLabel } from '../../lib/ages';

export async function getStaticPaths() {
  const themes = await getCollection('themes');
  return themes.map((theme) => ({
    params: { theme: theme.id },
    props: { theme },
  }));
}

const { theme } = Astro.props;
const { Content } = await render(theme);
const sheets = (await getCollection('sheets'))
  .filter((sheet) => sheet.data.theme === theme.id)
  .sort((a, b) => a.data.order - b.data.order);
const seasonal = theme.data.kind === 'seasonal';
const ageGroups = ageBands
  .map((band) => ({
    ...band,
    sheets: sheets.filter((sheet) => sheet.data.age === band.id),
  }))
  .filter((band) => band.sheets.length > 0);
const multiAge = ageGroups.length > 1;
const groupedByAge = seasonal || multiAge;
const themeEyebrow = seasonal
  ? 'Holiday'
  : multiAge
    ? ageSpanLabel(sheets.map((sheet) => sheet.data.age))
    : ageBandLabel(theme.data.ageBand);
const allThemes = await getCollection('themes');
const related = theme.data.related
  .map((id) => allThemes.find((item) => item.id === id))
  .filter((item) => item !== undefined);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: theme.data.title, path: themePath(theme.id) },
];
const pin = pinPath(theme.id, 'collection-1');
const pageUrl = absoluteUrl(themePath(theme.id));
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}#collection`,
      url: pageUrl,
      name: theme.data.title,
      description: theme.data.description,
      image: absoluteUrl(pin),
      datePublished: theme.data.pubDate.toISOString(),
      dateModified: theme.data.updatedDate.toISOString(),
      inLanguage: site.locale,
      isAccessibleForFree: true,
      author: { '@id': founderId },
      publisher: publisherRef(),
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: sheets.length,
        itemListElement: sheets.map((sheet, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: sheet.data.title,
          url: absoluteUrl(sheetPath(theme.id, sheet.data.slug)),
        })),
      },
    },
    ...(theme.data.faqs.length > 0
      ? [
          {
            '@type': 'FAQPage',
            '@id': `${pageUrl}#faq`,
            mainEntity: theme.data.faqs.map((faq) => ({
              '@type': 'Question',
              name: faq.question,
              acceptedAnswer: { '@type': 'Answer', text: faq.answer },
            })),
          },
        ]
      : []),
    breadcrumbLd(crumbs),
  ],
};
---

<Base
  title={theme.data.title}
  description={theme.data.description}
  path={themePath(theme.id)}
  ogImage={pin}
  ogAlt={theme.data.tagline}
  type="article"
  jsonLd={jsonLd}
>
  <div class="wrap with-rail">
    <article>
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">{themeEyebrow}</p>
      <h1>{theme.data.title}</h1>
      <p class="lede">{theme.data.tagline}</p>
      {groupedByAge ? (
        ageGroups.map((band) => (
          <section class="age-block" id={`ages-${band.id}`}>
            <h2>{band.label}</h2>
            <div class="sheet-grid">
              {band.sheets.map((sheet) => <SheetCard sheet={sheet} />)}
            </div>
          </section>
        ))
      ) : (
        <div class="sheet-grid">
          {sheets.map((sheet) => <SheetCard sheet={sheet} />)}
        </div>
      )}
      <AdSlot name="top" />
      <div class="prose">
        <Content />
      </div>
      <AdSlot name="article" />
      {related.length > 0 && (
        <section class="section">
          <h2>More sets to print</h2>
          <div class="related-grid">
            {related.map((item) => (
              <a class="related-card" href={themePath(item.id)}>
                <strong>{item.data.title}</strong>
                <span>{item.data.tagline}</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
    <aside class="rail">
      <div class="tip">
        <h2>Print tip</h2>
        <p>I made these for letter paper. There's an A4 file too if that's what you have. On the printer, pick actual size, or fit-to-page if it warns you.</p>
        <a href="/how-to-print/">How to print these pages</a>
      </div>
      <AdSlot name="sidebar" />
    </aside>
  </div>
  <FaqList items={theme.data.faqs} />
</Base>
