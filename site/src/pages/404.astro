---
import Base from '../layouts/Base.astro';
import { site } from '../site';
---

<Base title="Page not found" description={`That coloring page is not on ${site.name}.`} path="/404/" noindex>
  <div class="wrap prose">
    <h1>That page is not here</h1>
    <p>I don't have that page. The sets are on the home page.</p>
    <p><a class="btn" href="/">Back to the coloring pages</a></p>
  </div>
</Base>
