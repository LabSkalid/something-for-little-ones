---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { absoluteUrl } from '../../site';
import { publisherRef, websiteId } from '../../lib/schema';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);

const pageTitle = 'Guides for parents and teachers';
const pageIntro =
  'Short, practical guides on choosing, using, and printing coloring pages at home and in the classroom.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: pageTitle,
      description: pageIntro,
      url: absoluteUrl('/guides/'),
      isPartOf: { '@id': websiteId },
      publisher: publisherRef(),
    },
    {
      '@type': 'ItemList',
      name: pageTitle,
      itemListElement: guides.map((guide, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: guide.data.title,
        url: absoluteUrl(`/guides/${guide.id}/`),
      })),
    },
  ],
};
---

<Base title={pageTitle} description={pageIntro} path="/guides/" jsonLd={jsonLd}>
  <div class="wrap">
    <section class="page-intro">
      <h1>{pageTitle}</h1>
      <p class="lede">{pageIntro}</p>
    </section>

    <section class="section">
      <ul class="age-choices guide-list">
        {guides.map((guide) => (
          <li>
            <a class="age-choice" href={`/guides/${guide.id}/`}>
              <strong>{guide.data.title}</strong>
              <span>{guide.data.blurb}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
