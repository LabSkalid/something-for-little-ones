---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { absoluteUrl, site } from '../../site';
import { publisherRef, websiteId } from '../../lib/schema';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

const others = (await getCollection('guides'))
  .filter((other) => other.id !== guide.id)
  .sort((a, b) => a.data.order - b.data.order);

const path = `/guides/${guide.id}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: guide.data.title,
      description: guide.data.description,
      url: absoluteUrl(path),
      mainEntityOfPage: absoluteUrl(path),
      datePublished: guide.data.pubDate.toISOString(),
      dateModified: guide.data.updatedDate.toISOString(),
      inLanguage: site.locale,
      isPartOf: { '@id': websiteId },
      author: publisherRef(),
      publisher: publisherRef(),
    },
  ],
};
---

<Base
  title={guide.data.title}
  description={guide.data.description}
  path={path}
  type="article"
  jsonLd={jsonLd}
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><a href="/guides/">Guides</a><span>/</span><span>{guide.data.title}</span>
    </nav>

    <article class="prose guide-body">
      <h1>{guide.data.title}</h1>
      <Content />
    </article>

    {others.length > 0 && (
      <section class="prose guide-body">
        <h2>More guides</h2>
        <ul>
          {others.map((other) => (
            <li><a href={`/guides/${other.id}/`}>{other.data.title}</a></li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>
