---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ThemeCard from '../components/ThemeCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { site } from '../site';
import { pinPath, sheetAssets, themePath } from '../lib/paths';
import { publisher } from '../lib/schema';

const themes = (await getCollection('themes')).sort((a, b) => a.data.order - b.data.order);
const sheets = await getCollection('sheets');
const everyday = themes.filter((theme) => theme.data.kind === 'evergreen');
const seasonal = themes.filter((theme) => theme.data.kind === 'seasonal');

function cover(themeId: string) {
  const first = sheets
    .filter((sheet) => sheet.data.theme === themeId)
    .sort((a, b) => a.data.order - b.data.order)[0];
  return first
    ? { src: sheetAssets(themeId, first.data.slug).png, alt: first.data.alt, count: sheets.filter((sheet) => sheet.data.theme === themeId).length }
    : { src: pinPath(themeId, 'set'), alt: '', count: 0 };
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: site.name,
      url: site.url,
      description: site.description,
      inLanguage: 'en-US',
      publisher: publisher(),
    },
    {
      '@type': 'ItemList',
      name: 'Coloring page sets',
      itemListElement: themes.map((theme, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: theme.data.title,
        url: new URL(themePath(theme.id), site.url).href,
      })),
    },
  ],
};
---

<Base
  title={site.tagline}
  description={site.description}
  path="/"
  ogImage={pinPath('animal-coloring-pages', 'set')}
  ogAlt="A set of free animal coloring pages to print"
  jsonLd={jsonLd}
>
  <div class="wrap">
    <section class="page-intro">
      <h1>{site.tagline}</h1>
      <p class="lede">Free coloring pages to print for kids. Pick a set, then download a US Letter or A4 PDF.</p>
      <div class="hero-actions">
        <a class="btn" href="#everyday">Browse coloring pages</a>
      </div>
    </section>

    <section class="section" id="everyday">
      <div class="section-head">
        <h2>Coloring pages</h2>
        <p>Animals, dinosaurs, cars, and princesses. These sets stay up all year.</p>
      </div>
      <div class="theme-grid">
        {everyday.map((theme) => {
          const art = cover(theme.id);
          return (
            <ThemeCard
              href={themePath(theme.id)}
              title={theme.data.title}
              image={art.src}
              imageAlt={art.alt}
              count={art.count}
              eyebrow="Any day"
            />
          );
        })}
      </div>
    </section>

    <section class="section" id="seasonal">
      <div class="section-head">
        <h2>Seasonal sets</h2>
        <p>Fall, Halloween, and Christmas.</p>
      </div>
      <div class="theme-grid">
        {seasonal.map((theme) => {
          const art = cover(theme.id);
          return (
            <ThemeCard
              href={themePath(theme.id)}
              title={theme.data.title}
              image={art.src}
              imageAlt={art.alt}
              count={art.count}
              eyebrow="Seasonal"
            />
          );
        })}
      </div>
    </section>

    <AdSlot name="top" />
    <section class="section prose">
      <p>
        Download the PDF, not a screenshot of this page. US Letter fits most home printers in the United States. A4 is there when the paper says A4. The <a href="/how-to-print/">printing guide</a> covers the setting.
      </p>
    </section>
  </div>
</Base>
