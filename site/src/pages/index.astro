---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ThemeCard from '../components/ThemeCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { absoluteUrl, site } from '../site';
import { ageBandLabel, ageBands } from '../lib/ages';
import { pinPath, sheetAssets, themePath } from '../lib/paths';
import { publisherRef, websiteId } from '../lib/schema';

const themes = (await getCollection('themes')).sort((a, b) => a.data.order - b.data.order);
const sheets = await getCollection('sheets');
const everyday = themes.filter((theme) => theme.data.kind !== 'seasonal');
const holidays = themes.filter((theme) => theme.data.kind === 'seasonal');
const grouped = ageBands.map((band) => ({
  ...band,
  hint:
    {
      '2-3': 'Huge shapes',
      '3-4': 'Animals, dinosaurs, cars, princesses',
      '4-5': 'Garden and simple vehicles',
      '5-6': 'Ocean and dinosaur scenes',
      '6-8': 'Town and woodland',
    }[band.id] ?? band.label,
  themes: everyday.filter((theme) => theme.data.ageBand === band.id),
}));

const subjectChoices: { id: string; title: string; hint: string; note?: string; ids: string[] }[] = [
  {
    id: 'animals',
    title: 'Animals',
    hint: 'Ages 2–3, 3–4, and 6–8',
    note: 'Three ages. Open one and those pictures show up below.',
    ids: ['first-animal-coloring-pages', 'animal-coloring-pages', 'woodland-animal-coloring-pages'],
  },
  {
    id: 'dinosaurs',
    title: 'Dinosaurs',
    hint: 'Ages 3–4 and 5–6',
    note: 'Two ages. Open one and those pictures show up below.',
    ids: ['dinosaur-coloring-pages', 'dinosaur-scene-coloring-pages'],
  },
  {
    id: 'cars',
    title: 'Cars and trucks',
    hint: 'Ages 3–4 and 4–5',
    note: 'Two ages. Open one and those pictures show up below.',
    ids: ['car-coloring-pages', 'simple-vehicle-coloring-pages'],
  },
  {
    id: 'princesses',
    title: 'Princesses',
    hint: 'Ages 3–4',
    ids: ['princess-coloring-pages'],
  },
  {
    id: 'garden',
    title: 'Garden',
    hint: 'Ages 4–5',
    ids: ['garden-coloring-pages'],
  },
  {
    id: 'ocean',
    title: 'Ocean',
    hint: 'Ages 5–6',
    ids: ['ocean-scene-coloring-pages'],
  },
  {
    id: 'town',
    title: 'Town',
    hint: 'Ages 6–8',
    ids: ['town-scene-coloring-pages'],
  },
];

const everydayById = new Map(everyday.map((theme) => [theme.id, theme]));
const themeChoices = subjectChoices
  .map((choice) => ({
    ...choice,
    themes: choice.ids.flatMap((id) => {
      const theme = everydayById.get(id);
      return theme ? [theme] : [];
    }),
  }))
  .filter((choice) => choice.themes.length > 0);
const themePanels = themeChoices.filter((choice) => choice.themes.length > 1);
const holidayNames: Record<string, string> = {
  'fall-coloring-pages': 'Fall',
  'halloween-coloring-pages': 'Halloween',
  'thanksgiving-coloring-pages': 'Thanksgiving',
  'christmas-coloring-pages': 'Christmas',
  'christian-christmas-coloring-pages': 'Christian Christmas',
};
const holidayTiles = ['fall-coloring-pages', 'halloween-coloring-pages', 'thanksgiving-coloring-pages', 'christmas-coloring-pages', 'christian-christmas-coloring-pages'].flatMap((id) => {
  const theme = holidays.find((item) => item.id === id);
  return theme ? [{ theme, title: holidayNames[id] ?? theme.data.title }] : [];
});

function cover(themeId: string) {
  const first = sheets
    .filter((sheet) => sheet.data.theme === themeId)
    .sort((a, b) => a.data.order - b.data.order)[0];
  return first
    ? { src: sheetAssets(themeId, first.data.slug).png, alt: first.data.alt, count: sheets.filter((sheet) => sheet.data.theme === themeId).length }
    : { src: pinPath(themeId, 'collection-1'), alt: '', count: 0 };
}

const pageTitle = 'Free printable coloring pages for kids';
const pageIntro =
  'Looking for something simple to print and color? Something for Little Ones has free coloring pages for toddlers, preschoolers, and older kids, with easy pictures, animals, dinosaurs, vehicles, princesses, nature scenes, and holiday coloring pages.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: site.name,
      url: absoluteUrl('/'),
      description: pageIntro,
      inLanguage: site.locale,
      publisher: publisherRef(),
    },
    {
      '@type': 'ItemList',
      name: 'Coloring page sets by age',
      itemListElement: themes.map((theme, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: theme.data.title,
        url: absoluteUrl(themePath(theme.id)),
      })),
    },
  ],
};
---

<Base
  title={pageTitle}
  description={pageIntro}
  path="/"
  ogImage={pinPath('animal-coloring-pages', 'collection-1')}
  ogAlt="Animal coloring pages, starting with a puppy"
  jsonLd={jsonLd}
>
  <div class="wrap">
    <section class="page-intro">
      <h1>{pageTitle}</h1>
      <p class="lede">{pageIntro}</p>
      <p class="lede">
        Choose pages by age or by theme, then download and print the PDF at home. The sets range from big, simple shapes for ages 2–3 to fuller scenes and patterns for ages 6–8.
      </p>
      <div class="hero-actions">
        <a class="btn" href="#ages">Choose by age</a>
        <a class="btn" href="#themes">Choose by theme</a>
      </div>
    </section>

    <section class="section" id="ages">
      <div class="section-head">
        <h2>Choose coloring pages by age</h2>
        <p>
          Younger children usually need larger shapes and fewer details. Older kids can enjoy pictures with more parts, patterns, and scenes. The age groups here are based on the amount of detail on the page, so you can choose what feels right for your child.
        </p>
      </div>
      <ul class="age-choices">
        {grouped.map((band) => (
          <li>
            <a class="age-choice" href={`#age-${band.id}`}>
              <strong>{band.label}</strong>
              <span>{band.hint}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="section" id="themes">
      <div class="section-head">
        <h2>Find a coloring page by theme</h2>
        <p>
          Pick a favorite subject, from animals and dinosaurs to cars, princesses, gardens, and ocean scenes. Seasonal pages are collected separately for fall, Halloween, Thanksgiving, Christmas, and Christian Christmas.
        </p>
      </div>
      <ul class="age-choices">
        {themeChoices.map((choice) => (
          <li>
            <a class="age-choice" href={choice.themes.length > 1 ? `#theme-${choice.id}` : `#${choice.themes[0].id}`}>
              <strong>{choice.title}</strong>
              <span>{choice.hint}</span>
            </a>
          </li>
        ))}
        {holidayTiles.map(({ theme, title }) => (
          <li>
            <a class="age-choice" href={`#${theme.id}`}>
              <strong>{title}</strong>
              <span>Holiday</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {themePanels.map((choice) => (
      <section class="section theme-panel" id={`theme-${choice.id}`}>
        <div class="section-head">
          <h2>{choice.title}</h2>
          {choice.note && <p>{choice.note}</p>}
        </div>
        <ul class="age-choices">
          {choice.themes.map((theme) => (
            <li>
              <a class="age-choice" href={`#${theme.id}`}>
                <strong>{ageBandLabel(theme.data.ageBand)}</strong>
                <span>{theme.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {grouped.map((band) => (
      <section class="section age-shelf" id={`age-${band.id}`}>
        <div class="section-head">
          <h2>{band.label}</h2>
          <p>{band.blurb}</p>
        </div>
        <div class="theme-grid">
          {band.themes.map((theme) => {
            const art = cover(theme.id);
            return (
              <ThemeCard
                id={theme.id}
                href={themePath(theme.id)}
                title={theme.data.title}
                image={art.src}
                imageAlt={art.alt}
                count={art.count}
                eyebrow={band.label}
              />
            );
          })}
        </div>
      </section>
    ))}

    <AdSlot name="top" />
    <section class="section">
      <div class="section-head">
        <h2>Simple coloring pages to print at home</h2>
        <p>
          I make these coloring pages for families who want something easy to print and use without a lot of preparation. Some pages are deliberately very simple for toddlers, while others have more details for children who enjoy spending longer with a picture.
        </p>
        <p>
          Every set includes printable PDF pages you can use at home or in the classroom. Choose a theme or an age group, download a set, and print the pages you need.
        </p>
      </div>
    </section>

    <section class="section" id="holidays">
      <div class="section-head">
        <h2>Holidays</h2>
        <p>Fall, Halloween, Thanksgiving, Christmas, and Christian Christmas. Open a holiday, then pick an age.</p>
      </div>
      <div class="theme-grid">
        {holidayTiles.map(({ theme }) => {
          const art = cover(theme.id);
          return (
            <ThemeCard
              id={theme.id}
              href={themePath(theme.id)}
              title={theme.data.title}
              image={art.src}
              imageAlt={art.alt}
              count={art.count}
              eyebrow="Holiday"
            />
          );
        })}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>Printing the pages</h2>
        <p>
          I drew these, and you can print them at home or for a class. The files are made for US Letter paper, with an A4 version available too. Download the PDF rather than a screenshot of the page. <a href="/how-to-print/">How to print</a> covers the printer settings.
        </p>
      </div>
    </section>
  </div>
</Base>
