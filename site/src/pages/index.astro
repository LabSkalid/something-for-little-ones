---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ThemeCard from '../components/ThemeCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { absoluteUrl, site } from '../site';
import { ageBandLabel, ageBands, ageSpanLabel } from '../lib/ages';
import { pinPath, sheetAssets, themePath } from '../lib/paths';
import { publisherRef, websiteId } from '../lib/schema';
import { getCurrentSeason } from '../lib/seasons';

const themes = (await getCollection('themes')).sort((a, b) => a.data.order - b.data.order);
const sheets = await getCollection('sheets');
const guides = (await getCollection('guides'))
  .sort((x, y) => x.data.order - y.data.order)
  .slice(0, 3);
const everyday = themes.filter((theme) => theme.data.kind !== 'seasonal');
const holidays = themes.filter((theme) => theme.data.kind === 'seasonal');
const sheetAges = (themeId: string) =>
  sheets.filter((sheet) => sheet.data.theme === themeId).map((sheet) => sheet.data.age);
const spansAges = (themeId: string) => new Set(sheetAges(themeId)).size > 1;
const themeHasAge = (themeId: string, age: string) =>
  sheets.some((sheet) => sheet.data.theme === themeId && sheet.data.age === age);

const grouped = ageBands.map((band) => ({
  ...band,
  hint:
    {
      '2-3': 'Huge shapes',
      '3-4': 'Animals, dinosaurs, cars, princesses',
      '4-5': 'Chunky animals, garden, vehicles',
      '5-6': 'Patterns, ocean, dinosaur scenes',
      '6-8': 'Town, farm, woodland, fairy tales',
    }[band.id] ?? band.label,
  // Single-age sets plus multi-age sets (e.g. rockets) that have pages for this band.
  themes: everyday.filter(
    (theme) =>
      themeHasAge(theme.id, band.id) &&
      (theme.data.ageBand === band.id || spansAges(theme.id)),
  ),
}));

// Subject chips on the homepage. The FIRST id in each list is the main page the chip links to.
// The other sets are still reachable from the age shelves below.
const subjectChoices: { id: string; title: string; hint: string; ids: string[] }[] = [
  {
    id: 'animals',
    title: 'Animals',
    hint: 'Ages 2–8',
    ids: ['animal-coloring-pages', 'first-animal-coloring-pages', 'woodland-animal-coloring-pages'],
  },
  {
    id: 'dinosaurs',
    title: 'Dinosaurs',
    hint: 'Ages 3–6',
    ids: ['dinosaur-coloring-pages', 'dinosaur-scene-coloring-pages'],
  },
  {
    id: 'cars',
    title: 'Cars and trucks',
    hint: 'Ages 3–5',
    ids: ['car-coloring-pages', 'simple-vehicle-coloring-pages'],
  },
  { id: 'rockets', title: 'Rockets', hint: 'Ages 2–8', ids: ['rocket-coloring-pages'] },
  { id: 'princesses', title: 'Princesses', hint: 'Ages 3–4', ids: ['princess-coloring-pages'] },
  { id: 'garden', title: 'Garden', hint: 'Ages 4–5', ids: ['garden-coloring-pages'] },
  { id: 'ocean', title: 'Ocean', hint: 'Ages 5–6', ids: ['ocean-scene-coloring-pages'] },
  { id: 'town', title: 'Town', hint: 'Ages 6–8', ids: ['town-scene-coloring-pages'] },
];

const holidayNames: Record<string, string> = {
  'fall-coloring-pages': 'Fall',
  'halloween-coloring-pages': 'Halloween',
  'thanksgiving-coloring-pages': 'Thanksgiving',
  'winter-coloring-pages': 'Winter',
  'christmas-coloring-pages': 'Christmas',
  'christian-christmas-coloring-pages': 'Christian Christmas',
};
const shortThemeTitle = (title: string) => title.replace(/ Coloring Pages$/i, '');

const season = getCurrentSeason();
const seasonIds = new Set<string>(season?.themeIds ?? []);

// Holiday grid: in-season holidays first, the rest in their normal order.
const holidayTiles = holidays
  .slice()
  .sort(
    (a, b) =>
      Number(seasonIds.has(b.id)) - Number(seasonIds.has(a.id)) || a.data.order - b.data.order,
  )
  .map((theme) => ({
    theme,
    title: holidayNames[theme.id] ?? shortThemeTitle(theme.data.title),
  }));
const holidaysById = new Map(holidays.map((theme) => [theme.id, theme]));
const seasonThemes = season
  ? season.themeIds.flatMap((id) => {
      const theme = holidaysById.get(id);
      return theme ? [theme] : [];
    })
  : [];

// Any everyday theme not listed above (e.g. new themes) gets its own chip automatically.
const claimedThemeIds = new Set(subjectChoices.flatMap((choice) => choice.ids));
const extraThemeChoices = everyday
  .filter((theme) => !claimedThemeIds.has(theme.id))
  .map((theme) => ({
    id: theme.id,
    title: shortThemeTitle(theme.data.title),
    hint: spansAges(theme.id) ? ageSpanLabel(sheetAges(theme.id)) : ageBandLabel(theme.data.ageBand),
    ids: [theme.id],
  }));
const everydayById = new Map(everyday.map((theme) => [theme.id, theme]));
const themeChoices = [...subjectChoices, ...extraThemeChoices]
  .map((choice) => ({
    ...choice,
    themes: choice.ids.flatMap((id) => {
      const theme = everydayById.get(id);
      return theme ? [theme] : [];
    }),
  }))
  .filter((choice) => choice.themes.length > 0);

function cover(themeId: string, age?: string) {
  const inTheme = sheets.filter((sheet) => sheet.data.theme === themeId);
  const pool = age ? inTheme.filter((sheet) => sheet.data.age === age) : inTheme;
  const first = pool.slice().sort((a, b) => a.data.order - b.data.order)[0];
  return first
    ? {
        src: sheetAssets(themeId, first.data.slug).png,
        alt: first.data.alt,
        count: pool.length,
      }
    : { src: pinPath(themeId, 'collection-1'), alt: '', count: 0 };
}

const pageTitle = 'Free printable coloring pages for kids';

// Visible intro text (can be long).
const pageIntro =
  'Looking for something simple to print and color? Something for Little Ones has free coloring pages for toddlers, preschoolers, and older kids, with easy pictures, animals, dinosaurs, vehicles, princesses, nature scenes, and holiday coloring pages.';

// Meta description: keep under ~155 characters so Google doesn't cut it.
const metaDescription =
  'Free printable coloring pages for kids ages 2–8. Download PDFs by age or theme: animals, dinosaurs, cars, princesses, holidays and more.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: site.name,
      url: absoluteUrl('/'),
      description: metaDescription,
      inLanguage: site.locale,
      publisher: publisherRef(),
    },
    {
      '@type': 'ItemList',
      name: 'Free printable coloring page sets',
      numberOfItems: themes.length,
      itemListElement: themes.map((theme, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: theme.data.title,
        url: absoluteUrl(themePath(theme.id)),
      })),
    },
  ],
};
---

<Base
  title={pageTitle}
  description={metaDescription}
  path="/"
  ogImage={pinPath('animal-coloring-pages', 'collection-1')}
  ogAlt="Animal coloring pages, starting with a puppy"
  jsonLd={jsonLd}
>
  {/* TODO: replace ogImage with a landscape 1200x630 branded image, e.g. ogImage="/og-home.png" */}
  <div class="wrap">
    <section class="page-intro">
      <h1>{pageTitle}</h1>
      <p class="lede">{pageIntro}</p>
      <p class="lede">
        Pick a set by age or theme, then download the PDF and print it at home. Sets range from big, simple shapes for ages 2–3 to fuller scenes and patterns for ages 6–8.
      </p>
      <div class="hero-actions">
        <a class="btn" href="#ages">Choose by age</a>
        <a class="btn" href="#themes">Choose by theme</a>
      </div>
    </section>

    {seasonThemes.length > 0 && season && (
      <section class="section season-spotlight" id="season">
        <div class="section-head">
          <h2>{season.label}</h2>
          <p>{season.blurb}</p>
        </div>
        <div class="theme-grid">
          {seasonThemes.map((theme) => {
            const art = cover(theme.id);
            return (
              <ThemeCard
                href={themePath(theme.id)}
                title={theme.data.title}
                image={art.src}
                imageAlt={art.alt}
                count={art.count}
                eyebrow={holidayNames[theme.id] ?? shortThemeTitle(theme.data.title)}
              />
            );
          })}
        </div>
      </section>
    )}

    <section class="section" id="ages">
      <div class="section-head">
        <h2>Choose coloring pages by age</h2>
        <p>
          Younger children usually need larger shapes and fewer details. Older kids can enjoy pictures with more parts, patterns, and scenes. The age groups here are based on the amount of detail on the page, so you can choose what feels right for your child.
        </p>
      </div>
      <ul class="age-choices">
        {grouped.map((band) => (
          <li>
            <a class="age-choice" href={`#age-${band.id}`}>
              <strong>{band.label}</strong>
              <span>{band.hint}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="section" id="themes">
      <div class="section-head">
        <h2>Find a coloring page by theme</h2>
        <p>
          Pick a favorite subject, from animals and dinosaurs to cars, rockets, princesses, gardens, and ocean scenes. Holiday and seasonal pages are in the Holidays section below.
        </p>
      </div>
      <ul class="age-choices">
        {themeChoices.map((choice) => (
          <li>
            <a class="age-choice" href={themePath(choice.themes[0].id)}>
              <strong>{choice.title}</strong>
              <span>{choice.hint}</span>
            </a>
          </li>
        ))}
        <li>
          <a class="age-choice" href="#holidays">
            <strong>Holidays</strong>
            <span>Seasonal pages</span>
          </a>
        </li>
      </ul>
    </section>

    {grouped.map((band) => (
      <section class="section age-shelf" id={`age-${band.id}`}>
        <div class="section-head">
          <h2>Coloring pages for {band.label.toLowerCase()}</h2>
          <p>{band.blurb}</p>
        </div>
        <div class="theme-grid">
          {band.themes.map((theme) => {
            const multi = spansAges(theme.id);
            const art = cover(theme.id, multi ? band.id : undefined);
            return (
              <ThemeCard
                id={multi ? `${theme.id}--${band.id}` : theme.id}
                href={multi ? `${themePath(theme.id)}#ages-${band.id}` : themePath(theme.id)}
                title={theme.data.title}
                image={art.src}
                imageAlt={art.alt}
                count={art.count}
                eyebrow={band.label}
              />
            );
          })}
        </div>
      </section>
    ))}

    <section class="section" id="holidays">
      <div class="section-head">
        <h2>Holiday and seasonal coloring pages</h2>
        <p>Seasonal coloring pages for every time of year. Open a holiday, then pick an age.</p>
      </div>
      <div class="theme-grid">
        {holidayTiles.map(({ theme }) => {
          const art = cover(theme.id);
          return (
            <ThemeCard
              id={theme.id}
              href={themePath(theme.id)}
              title={theme.data.title}
              image={art.src}
              imageAlt={art.alt}
              count={art.count}
              eyebrow="Holiday"
            />
          );
        })}
      </div>
    </section>

    <AdSlot name="top" />

    <section class="section">
      <div class="section-head">
        <h2>Simple coloring pages to print at home</h2>
        <p>
          I make these coloring pages for families who want something easy to print and use without a lot of preparation. Some pages are deliberately very simple for toddlers, while others have more details for children who enjoy spending longer with a picture.
        </p>
        <p>
          Every set includes printable PDF pages you can use at home or in the classroom. Choose a theme or an age group, download a set, and print the pages you need.
        </p>
      </div>
    </section>

    {guides.length > 0 && (
      <section class="section" id="guides">
        <div class="section-head">
          <h2>For parents and teachers</h2>
          <p>Short guides on choosing, using, and printing coloring pages.</p>
        </div>
        <ul class="age-choices">
          {guides.map((guide) => (
            <li>
              <a class="age-choice" href={`/guides/${guide.id}/`}>
                <strong>{guide.data.title}</strong>
                <span>{guide.data.blurb}</span>
              </a>
            </li>
          ))}
        </ul>
        <p><a class="card-action" href="/guides/">All guides</a></p>
      </section>
    )}

    <section class="section">
      <div class="section-head">
        <h2>Printing the pages</h2>
        <p>
          I drew these, and you can print them at home or for a class. The files are made for US Letter paper, with an A4 version available too. Download the PDF rather than a screenshot of the page. <a href="/how-to-print/">How to print</a> covers the printer settings.
        </p>
      </div>
    </section>
  </div>
</Base>