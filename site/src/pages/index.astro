---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ThemeCard from '../components/ThemeCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { site } from '../site';
import { ageBands } from '../lib/ages';
import { pinPath, sheetAssets, themePath } from '../lib/paths';
import { publisher } from '../lib/schema';

const themes = (await getCollection('themes')).sort((a, b) => a.data.order - b.data.order);
const sheets = await getCollection('sheets');
const everyday = themes.filter((theme) => theme.data.kind !== 'seasonal');
const holidays = themes.filter((theme) => theme.data.kind === 'seasonal');
const grouped = ageBands.map((band) => ({
  ...band,
  themes: everyday.filter((theme) => theme.data.ageBand === band.id),
}));

function cover(themeId: string) {
  const first = sheets
    .filter((sheet) => sheet.data.theme === themeId)
    .sort((a, b) => a.data.order - b.data.order)[0];
  return first
    ? { src: sheetAssets(themeId, first.data.slug).png, alt: first.data.alt, count: sheets.filter((sheet) => sheet.data.theme === themeId).length }
    : { src: pinPath(themeId, 'set'), alt: '', count: 0 };
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: site.name,
      url: site.url,
      description: site.description,
      inLanguage: 'en-US',
      publisher: publisher(),
    },
    {
      '@type': 'ItemList',
      name: 'Coloring page sets by age',
      itemListElement: themes.map((theme, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: theme.data.title,
        url: new URL(themePath(theme.id), site.url).href,
      })),
    },
  ],
};
---

<Base
  title={site.tagline}
  description={site.description}
  path="/"
  ogImage={pinPath('animal-coloring-pages', 'set')}
  ogAlt="A set of free animal coloring pages to print"
  jsonLd={jsonLd}
>
  <div class="wrap">
    <section class="page-intro">
      <h1>{site.tagline}</h1>
      <p class="lede">
        Printable line drawings sorted by age, from a few huge shapes to fuller scenes. Pick a set, then download a US Letter or A4 PDF.
      </p>
      <div class="hero-actions">
        <a class="btn" href="#ages-2-3">Browse by age</a>
      </div>
    </section>

    {grouped.map((band) => (
      <section class="section" id={`ages-${band.id}`}>
        <div class="section-head">
          <h2>{band.label}</h2>
          <p>{band.blurb}</p>
        </div>
        <div class="theme-grid">
          {band.themes.map((theme) => {
            const art = cover(theme.id);
            const eyebrow = band.label;
            return (
              <ThemeCard
                href={themePath(theme.id)}
                title={theme.data.title}
                image={art.src}
                imageAlt={art.alt}
                count={art.count}
                eyebrow={eyebrow}
              />
            );
          })}
        </div>
      </section>
    ))}

    <AdSlot name="top" />
    <section class="section prose">
      <p>
        The age on a set is a guide for how many lines are on the page. A child who still wants big shapes can stay on an easier shelf. Download the PDF, not a screenshot of this page. The <a href="/how-to-print/">printing guide</a> covers US Letter and A4.
      </p>
    </section>

    <section class="section" id="holidays">
      <div class="section-head">
        <h2>Holidays</h2>
        <p>Fall, Halloween, and Christmas. Open a holiday, then pick an age from 2–3 through 6–8.</p>
      </div>
      <div class="theme-grid">
        {holidays.map((theme) => {
          const art = cover(theme.id);
          return (
            <ThemeCard
              href={themePath(theme.id)}
              title={theme.data.title}
              image={art.src}
              imageAlt={art.alt}
              count={art.count}
              eyebrow="Seasonal"
            />
          );
        })}
      </div>
    </section>
  </div>
</Base>
