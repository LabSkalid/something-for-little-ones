---
import Base from '../layouts/Base.astro';
import { absoluteUrl } from '../site';
import { founderId, organizationId } from '../lib/schema';

const jsonLd = {
  '@type': 'Person',
  '@id': founderId,
  name: 'Julia',
  description: 'A mom of two who makes the free coloring pages on Something for Little Ones.',
  url: absoluteUrl('/about/'),
  worksFor: { '@id': organizationId },
};
---

<Base title="About" description="Julia, a mom of two, shares how Something for Little Ones started and the free coloring pages and printables she is putting together." path="/about/" jsonLd={jsonLd}>
  <div class="wrap prose">
    <p class="eyebrow">About</p>
    <h1>About Something for Little Ones</h1>
    <p>Hi, I'm Julia.</p>
    <p>I'm a mom of two, and Something for Little Ones started because I kept finding myself at the kitchen table looking for something to print.</p>
    <p>A coloring page for a rainy afternoon. Something to take along on a road trip. A little activity to keep the kids busy while dinner was getting made.</p>
    <p>So I started making my own.</p>
    <p>This site is where I'm putting them all together — free coloring pages, printable activities, games, and whatever else I end up making.</p>
    <p>Some are very simple. Some have a few more details. Some are seasonal, and some are just things my kids happen to like.</p>
    <p>I'm adding new pages as I make them, so this little library will keep growing.</p>
    <p>Thanks for stopping by!</p>
    <p>Julia</p>
  </div>
</Base>
